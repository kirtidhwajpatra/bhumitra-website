---
import MapApp from "../components/map/MapApp";
import { FAQS } from "../components/panel/LandingPanel";
import "../styles/tokens.css";
import "../styles/app.css";
import "../styles/panel.css";

const title = "Bhumitra: Odisha plot map & land records (Bhulekh RoR)";
const description =
  "See every plot in any Odisha village on a satellite map. Tap a plot for its owners, khata, area, kisam, government land value and registration cost from Bhulekh and IGR Odisha. Free daily searches.";
const site = "https://getbhumitra.in";

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${site}/#website`, name: "Bhumitra", url: `${site}/`, inLanguage: "en-IN" },
    {
      "@type": "WebApplication",
      name: "Bhumitra plot map",
      url: `${site}/`,
      applicationCategory: "ReferenceApplication",
      operatingSystem: "Any",
      browserRequirements: "Requires JavaScript and WebGL",
      areaServed: { "@type": "State", name: "Odisha" },
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
    },
    { "@type": "MobileApplication", name: "Bhumitra", operatingSystem: "iOS", applicationCategory: "ReferenceApplication", downloadUrl: "https://apps.apple.com/in/app/bhumitra/id6760656162", offers: { "@type": "Offer", price: "0", priceCurrency: "INR" } },
    { "@type": "FAQPage", mainEntity: FAQS.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })) },
  ],
};
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <meta name="theme-color" content="#01271A" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Bhumitra" />
    <meta property="og:title" content="Bhumitra: every plot in Odisha, on a map" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/img/og-home.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="apple-itunes-app" content="app-id=6760656162" />
    <link rel="icon" type="image/png" href="/img/icon-192.png" />
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/GoogleSans-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://server.arcgisonline.com" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <main>
      <MapApp client:load />
      <noscript><p class="noscript">The Bhumitra plot map needs JavaScript. You can still read our <a href="/blog/">land record guides</a>.</p></noscript>
    </main>
  </body>
</html>
